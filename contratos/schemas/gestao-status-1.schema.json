{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gestao-status/1",
  "title": "Status das iniciativas exportado por uma ferramenta de time",
  "description": "Escrito somente pela ferramenta do time em times/<slug>/status.json, dentro de um envelope gestao-envelope/1. É sempre um retrato completo (snapshot), nunca um delta. Campos desconhecidos são ignorados pela Central.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "generatedAt",
    "revision",
    "initiatives"
  ],
  "properties": {
    "schema": {
      "const": "gestao-status/1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0
    },
    "initiatives": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "localId",
          "name",
          "status"
        ],
        "properties": {
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2,5}-[0-9]{3,}$"
          },
          "localId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": [
              "ok",
              "attn",
              "late",
              "done",
              "paused"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "progressBasis": {
            "enum": [
              "cards",
              "points",
              "items",
              "manual"
            ]
          },
          "forecastEnd": {
            "type": "string",
            "format": "date"
          },
          "update": {
            "type": "object",
            "required": [
              "date",
              "text"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "author": {
                "type": "string"
              }
            }
          },
          "blockers": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "localId",
                "text"
              ],
              "properties": {
                "localId": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                },
                "since": {
                  "type": "string",
                  "format": "date"
                },
                "owner": {
                  "type": "string"
                }
              }
            }
          },
          "counts": {
            "type": "object",
            "description": "Contagens livres (ex.: cards_total, cards_done). Exibidas como texto.",
            "additionalProperties": {
              "type": "number"
            }
          },
          "link": {
            "type": "string",
            "pattern": "^https://"
          },
          "features": {
            "type": "array",
            "maxItems": 200,
            "description": "Visão do time sobre cada feature da Central em que trabalha (downstream). Nunca altera a feature na Central.",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "status"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Z]{2,5}-[0-9]{3,}\\.F[0-9]+$"
                },
                "status": {
                  "enum": [
                    "ok",
                    "attn",
                    "late",
                    "done",
                    "paused"
                  ]
                },
                "progress": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "forecastEnd": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string",
                  "maxLength": 300
                },
                "forecastBasis": {
                  "enum": [
                    "sprints",
                    "due"
                  ],
                  "description": "Opcional (desde 26/11/2026). De onde veio o forecastEnd: \"sprints\" quando saiu do desenho de sprints do time (vazão), \"due\" quando é o maior prazo dos cards."
                }
              }
            }
          },
          "items": {
            "type": "array",
            "maxItems": 500,
            "description": "Itens do time relevantes para o gestor, na hierarquia Iniciativa › Feature › Card (igual à Central). Uma feature criada pelo time vai como item com kind \"feature\"; os cards dentro dela levam featureLocalId com o localId dessa feature. Item ligado a uma feature da Central leva featureRef.",
            "items": {
              "type": "object",
              "required": [
                "localId",
                "title",
                "status"
              ],
              "properties": {
                "localId": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "kind": {
                  "type": "string",
                  "maxLength": 30,
                  "description": "tipo no vocabulário do time: feature, historia, entrega, spike…"
                },
                "status": {
                  "enum": [
                    "open",
                    "done",
                    "cancelled"
                  ]
                },
                "featureRef": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Z]{2,5}-[0-9]{3,}\\.F[0-9]+$"
                },
                "featureLocalId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Opcional (desde 26/11/2026). localId do item kind \"feature\" desta mesma iniciativa em que o card está (feature criada pelo time). Só com featureRef null. Quando o gestor liga essa feature a uma feature da Central, o card vai junto."
                },
                "sprintLocalId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Opcional (desde 26/11/2026). localId da sprint (em sprints[]) em que o card está planejado ou em andamento."
                },
                "due": {
                  "type": "string",
                  "format": "date"
                },
                "doneAt": {
                  "type": "string",
                  "format": "date"
                },
                "owner": {
                  "type": "string"
                },
                "link": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          }
        }
      }
    },
    "sprints": {
      "type": "array",
      "maxItems": 8,
      "description": "Opcional (desde 26/11/2026, contratos 1.2). Sprints do time ao vivo: a em andamento, as próximas planejadas e a última fechada. No máximo uma com state \"active\". O resultado oficial da sprint vai no metricas.json ao fechar.",
      "items": {
        "type": "object",
        "required": [
          "localId",
          "name",
          "state"
        ],
        "properties": {
          "localId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "enum": [
              "planned",
              "active",
              "closed"
            ]
          },
          "goal": {
            "type": "string",
            "maxLength": 300
          },
          "capacity": {
            "type": "object",
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "enum": [
                  "cards",
                  "points"
                ]
              }
            }
          },
          "committed": {
            "type": "integer",
            "minimum": 0,
            "description": "Cards na sprint quando ela começou (planejada: cards planejados até agora)."
          },
          "doneCommitted": {
            "type": "integer",
            "minimum": 0,
            "description": "Dos cards do compromisso, quantos já foram entregues."
          },
          "added": {
            "type": "integer",
            "minimum": 0,
            "description": "Cards que entraram depois do início."
          },
          "removed": {
            "type": "integer",
            "minimum": 0,
            "description": "Cards que saíram depois do início."
          },
          "blocked": {
            "type": "integer",
            "minimum": 0,
            "description": "Cards da sprint bloqueados agora."
          },
          "features": {
            "type": "array",
            "maxItems": 100,
            "description": "Quanto de cada feature está nesta sprint. ref para feature da Central, localId para feature criada pelo time (item kind \"feature\").",
            "items": {
              "type": "object",
              "required": [
                "cards"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Z]{2,5}-[0-9]{3,}\\.F[0-9]+$"
                },
                "localId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "cards": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "team",
        "tool"
      ],
      "properties": {
        "team": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "teamName": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    }
  }
}
