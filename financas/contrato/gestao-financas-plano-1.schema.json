{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gestao-financas-plano/1",
  "title": "Plano financeiro publicado por um time (conteúdo decifrado do envelope gestao-envelope/1)",
  "description": "Arquivo times/<time>/financas/plano.json. Retrato completo do plano do time. Um único dono (source.writer = pessoa~computador). Valores em centavos inteiros.",
  "type": "object",
  "required": ["schema", "revision", "generatedAt", "source", "fiscalYear", "currency", "lines"],
  "properties": {
    "schema": { "const": "gestao-financas-plano/1" },
    "revision": { "type": "integer", "minimum": 1, "description": "Sempre maior que qualquer revisão já vista na pasta (inclusive cópias de conflito)." },
    "generatedAt": { "type": "string", "description": "ISO 8601 com fuso." },
    "hlc": { "type": "string", "pattern": "^\\d+\\.\\d+$", "description": "Relógio lógico híbrido: desempate entre arquivos de mesma revisão." },
    "source": { "type": "object", "required": ["team", "writer"], "properties": {
      "team": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "writer": { "type": "string", "pattern": "^[a-z0-9]+~[a-z0-9]+$" },
      "tool": { "type": "string" }, "toolVersion": { "type": "string" } } },
    "team": { "type": "object", "properties": { "name": { "type": "string" }, "slug": { "type": "string" } } },
    "fiscalYear": { "type": "integer", "description": "Ano base do plano (o ano em curso). \"totals\" é deste ano." },
    "fiscalYears": { "type": "array", "items": { "type": "integer" }, "description": "Desde 1.1 (multianual): anos do horizonte do plano. Ausente = só fiscalYear. As linhas trazem os meses de todos estes anos e os 12 meses seguintes." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "planVersion": { "type": "string", "maxLength": 40, "description": "Ex.: Orçamento original, Reforecast 1." },
    "closedMonths": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" } },
    "categories": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "kind": { "enum": ["OPEX", "CAPEX"] } } } },
    "lines": { "type": "array", "items": { "type": "object", "required": ["id", "name", "category", "months"], "properties": {
      "id": { "type": "string" }, "name": { "type": "string", "maxLength": 120 }, "category": { "type": "string" }, "kind": { "enum": ["OPEX", "CAPEX"] },
      "costCenter": { "type": "string" }, "initiative": { "type": "string", "description": "Código da iniciativa na Central, ex.: PAG-042 (opcional)." }, "supplier": { "type": "string" },
      "months": { "type": "object", "propertyNames": { "pattern": "^\\d{4}-\\d{2}$" }, "additionalProperties": { "type": "object", "properties": {
        "budget": { "type": "integer" }, "forecast": { "type": "integer" }, "actual": { "type": "integer" } } } } } } },
    "commitments": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "line": { "type": "string" }, "monthly": { "type": "integer" }, "start": { "type": "string" }, "end": { "type": "string" } } } },
    "totals": { "type": "object", "properties": { "budget": { "type": "integer" }, "forecast": { "type": "integer" }, "actual": { "type": "integer" } } },
    "totalsByYear": { "type": "object", "description": "Desde 1.1: totais de cada ano de fiscalYears (ano → {budget, forecast, actual}). Conferência; o grupo soma pelos meses.", "propertyNames": { "pattern": "^\\d{4}$" }, "additionalProperties": { "type": "object", "properties": { "budget": { "type": "integer" }, "forecast": { "type": "integer" }, "actual": { "type": "integer" } } } },
    "directiveRevision": { "type": "integer" }
  }
}
